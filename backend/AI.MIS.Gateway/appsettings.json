{
  "Authentication": {
    "Issuer": "AI.MIS.Copilot",
    "Audience": "AI.MIS.Users"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Order": 0,
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users": {
        "ClusterId": "identity",
        "Order": 0,
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "menus": {
        "ClusterId": "identity",
        "Order": 0,
        "Match": { "Path": "/api/menus/{**catch-all}" }
      },
      "copilot": {
        "ClusterId": "copilot",
        "Order": 0,
        "Match": { "Path": "/api/copilot/{**catch-all}" }
      },
      "schema": {
        "ClusterId": "copilot",
        "Order": 0,
        "Match": { "Path": "/api/schema-metadata/{**catch-all}" }
      },
      "documents": {
        "ClusterId": "knowledge",
        "Order": 0,
        "Match": { "Path": "/api/documents/{**catch-all}" }
      },
      "reports": {
        "ClusterId": "reporting",
        "Order": 0,
        "Match": { "Path": "/api/misReports/{**catch-all}" }
      },
      "excel-imports": {
        "ClusterId": "reporting",
        "Order": 0,
        "Match": { "Path": "/api/excelImports/{**catch-all}" }
      },
      "loan-proposals": {
        "ClusterId": "reporting",
        "Order": 0,
        "Match": { "Path": "/api/LoanProposal/{**catch-all}" }
      },
      "system": {
        "ClusterId": "reporting",
        "Order": 0,
        "Match": { "Path": "/api/system/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "primary": { "Address": "http://localhost:5253/" } } },
      "copilot": { "Destinations": { "primary": { "Address": "http://localhost:5254/" } } },
      "knowledge": { "Destinations": { "primary": { "Address": "http://localhost:5255/" } } },
      "reporting": { "Destinations": { "primary": { "Address": "http://localhost:5256/" } } }
    }
  }
}
